---
import { siteConfig } from '../config/site.config';
import SectionHead from './SectionHead.astro';

const { process } = siteConfig.home;
---

<section class="section" aria-labelledby="process-heading">
  <div class="container">
    <SectionHead copy={process} center id="process-heading" />
    <ol class="list-reset steps">
      {
        process.steps.map((step, i) => (
          <li class="step reveal" style={`--reveal-i:${i}`}>
            <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>
              <span class="visually-hidden">Step {i + 1}: </span>
              {step.title}
            </h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 1rem;
    counter-reset: step;
  }

  @media (min-width: 40em) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 64em) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .step {
    position: relative;
    padding: 1.75rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .step__num {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    background: var(--color-primary-fill);
    color: var(--color-primary-contrast);
    font-weight: 700;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  /* Connector line between steps on wide screens */
  @media (min-width: 64em) {
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: calc(1.75rem + 1.375rem);
      left: calc(1.75rem + 2.75rem + 0.75rem);
      right: -0.75rem;
      height: 2px;
      background: linear-gradient(90deg, color-mix(in srgb, var(--color-primary) 45%, transparent), transparent);
    }
  }

  .step p {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
</style>
