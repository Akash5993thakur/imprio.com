---
import { siteConfig } from '../config/site.config';
import { linkAttrs, samePath } from '../lib/utils';
import Icon from './Icon.astro';

const current = Astro.url.pathname;
const { logo, headerCta } = siteConfig;
const cta = headerCta ? linkAttrs(headerCta) : undefined;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${siteConfig.businessName} — home`}>
      <img src={logo.src} alt="" width={logo.width ?? 40} height={logo.height ?? 40} class="brand__logo" />
      {siteConfig.showNameWithLogo && <span class="brand__name">{siteConfig.businessName}</span>}
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <Icon name="menu" class="nav-toggle__open" />
      <Icon name="close" class="nav-toggle__close" />
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="list-reset">
        {
          siteConfig.navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={samePath(item.href, current) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        headerCta && cta && (
          <a class="btn btn--primary site-nav__cta" href={cta.href} target={cta.target} rel={cta.rel}>
            {headerCta.icon && <Icon name={headerCta.icon} size={18} />}
            <span>{headerCta.label}</span>
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  const header = document.querySelector('.site-header');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
  // Soft shadow once the page is scrolled
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: saturate(1.6) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: 0 4px 20px rgb(11 21 48 / 0.05);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-secondary);
    font-weight: 800;
    font-size: 1.15rem;
    text-decoration: none;
  }

  .brand__logo {
    width: auto;
    height: 1.75rem;
  }

  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg);
    color: var(--color-secondary);
    cursor: pointer;
  }

  .nav-toggle :global(.nav-toggle__close),
  .nav-toggle[aria-expanded='true'] :global(.nav-toggle__open) {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] :global(.nav-toggle__close) {
    display: block;
  }

  /* Mobile: dropdown panel */
  .site-nav {
    display: none;
    position: absolute;
    inset: var(--header-h) 0 auto 0;
    padding: 0.5rem var(--gutter) 1.5rem;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }

  .site-nav.is-open {
    display: block;
  }

  .site-nav ul {
    margin-bottom: 1.25rem;
  }

  .site-nav li a {
    display: block;
    padding: 0.9rem 0.25rem;
    color: var(--color-text);
    font-weight: 550;
    font-size: 1.0625rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-primary-text);
  }

  .site-nav__cta {
    width: 100%;
  }

  /* Without JS the toggle can't work, so always show the nav inline. */
  :global(html:not(.js)) .nav-toggle {
    display: none;
  }

  :global(html:not(.js)) .site-nav {
    display: block;
    position: static;
    padding: 0;
    border: 0;
    box-shadow: none;
  }

  @media (min-width: 60em) {
    .brand__logo {
      height: 2rem;
    }

    .nav-toggle {
      display: none;
    }

    .site-nav,
    :global(html:not(.js)) .site-nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      position: static;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: none;
    }

    .site-nav ul {
      display: flex;
      gap: 0.25rem;
      margin: 0;
    }

    .site-nav li a {
      position: relative;
      padding: 0.5rem 0.85rem;
      border: 0;
      font-size: 0.975rem;
      color: var(--color-muted);
      transition: color 0.2s ease;
    }

    .site-nav li a:hover,
    .site-nav a[aria-current='page'] {
      color: var(--color-secondary);
    }

    .site-nav a[aria-current='page']::after {
      content: '';
      position: absolute;
      left: 0.85rem;
      right: 0.85rem;
      bottom: 0.15rem;
      height: 2px;
      border-radius: 2px;
      background: var(--color-primary);
    }

    .site-nav__cta {
      width: auto;
      min-height: 2.75rem;
      padding: 0.5rem 1.2rem;
      font-size: 0.95rem;
    }
  }
</style>
