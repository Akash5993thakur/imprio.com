---
import { siteConfig } from '../config/site.config';
import { samePath, telLink } from '../lib/utils';
import Icon from './Icon.astro';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${siteConfig.businessName} — home`}>
      <img
        src={siteConfig.logo.src}
        alt=""
        width={siteConfig.logo.width ?? 40}
        height={siteConfig.logo.height ?? 40}
        class="brand__logo"
      />
      <span class="brand__name">{siteConfig.businessName}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <Icon name="menu" class="nav-toggle__open" />
      <Icon name="close" class="nav-toggle__close" />
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          siteConfig.navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={samePath(item.href, current) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary site-nav__call" href={telLink()}>
        <Icon name="phone" size={18} />
        <span>{siteConfig.contact.phone}</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    backdrop-filter: saturate(1.5) blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-secondary);
    font-weight: 800;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .brand__logo {
    width: 2.5rem;
    height: 2.5rem;
  }

  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-secondary);
    cursor: pointer;
  }

  .nav-toggle :global(.nav-toggle__close),
  .nav-toggle[aria-expanded='true'] :global(.nav-toggle__open) {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] :global(.nav-toggle__close) {
    display: block;
  }

  /* Mobile: dropdown panel */
  .site-nav {
    display: none;
    position: absolute;
    inset: var(--header-h) 0 auto 0;
    padding: 1rem var(--gutter) 1.5rem;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow);
  }

  .site-nav.is-open {
    display: block;
  }

  .site-nav ul {
    list-style: none;
    padding: 0;
    margin-bottom: 1rem;
  }

  .site-nav li a {
    display: block;
    padding: 0.75rem 0.25rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-primary-text);
  }

  .site-nav__call {
    width: 100%;
  }

  /* Without JS the toggle can't work, so always show the nav inline. */
  :global(html:not(.js)) .nav-toggle {
    display: none;
  }

  :global(html:not(.js)) .site-nav {
    display: block;
    position: static;
    padding: 0;
    border: 0;
    box-shadow: none;
  }

  @media (min-width: 60em) {
    .nav-toggle {
      display: none;
    }

    .site-nav,
    :global(html:not(.js)) .site-nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      position: static;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: none;
    }

    .site-nav ul {
      display: flex;
      gap: 0.25rem;
      margin: 0;
    }

    .site-nav li a {
      padding: 0.5rem 0.75rem;
      border: 0;
      border-radius: 999px;
    }

    .site-nav li a:hover {
      background: var(--color-surface);
    }

    .site-nav a[aria-current='page'] {
      background: var(--color-surface);
    }

    .site-nav__call {
      width: auto;
      min-height: 2.5rem;
      padding: 0.5rem 1.1rem;
    }
  }
</style>
