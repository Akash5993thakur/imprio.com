---
import { siteConfig } from '../config/site.config';
import { formatAddress, telLink, whatsappLink } from '../lib/utils';
import Icon from './Icon.astro';
import OpeningHours from './OpeningHours.astro';

const platformLabel: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  x: 'X (Twitter)',
  linkedin: 'LinkedIn',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  google: 'Google Business Profile',
};
const logo = siteConfig.logoLight ?? siteConfig.logo;
const year = new Date().getFullYear();
---

<footer class="site-footer glow-bg">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" aria-label={`${siteConfig.businessName} — home`}>
        <img src={logo.src} alt="" width={logo.width ?? 40} height={logo.height ?? 40} class="site-footer__logo" />
      </a>
      <p class="site-footer__tagline">{siteConfig.tagline}</p>
      <p class="site-footer__desc">{siteConfig.description}</p>
      {
        siteConfig.social.length > 0 && (
          <ul class="social list-reset" aria-label="Social media">
            {siteConfig.social.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  <Icon name={s.platform} size={18} />
                  <span class="visually-hidden">{platformLabel[s.platform]} (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav aria-label="Footer">
      <h2 class="site-footer__heading">Explore</h2>
      <ul class="list-reset site-footer__links">
        {siteConfig.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__heading">Contact</h2>
      <ul class="list-reset site-footer__links">
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </li>
        <li><a href={telLink()}>{siteConfig.contact.phone}</a></li>
        <li><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></li>
        <li>
          <address>{formatAddress().map((line, i) => (i === 0 ? line : <><br />{line}</>))}</address>
        </li>
      </ul>
    </div>

    {
      siteConfig.hours.length > 0 && (
        <div>
          <h2 class="site-footer__heading">Hours</h2>
          <OpeningHours compact />
        </div>
      )
    }
  </div>
  <div class="container site-footer__bottom">
    <p>&copy; {year} {siteConfig.businessName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: 4rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 40em) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64em) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1.3fr;
      gap: 4rem;
    }

    .site-footer__grid:has(> :nth-child(4)) {
      grid-template-columns: 2fr 1fr 1.3fr 1.2fr;
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }

  .site-footer__logo {
    width: auto;
    height: 2rem;
  }

  .site-footer__tagline {
    margin-top: 1.25rem;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .site-footer__desc {
    max-width: 26rem;
    margin-top: 0.5rem;
    color: var(--color-on-dark-muted);
    font-size: 0.95rem;
  }

  .site-footer__heading {
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .site-footer__links {
    display: grid;
    gap: 0.6rem;
    color: var(--color-on-dark-muted);
  }

  .site-footer__links a:hover {
    color: #fff;
  }

  address {
    font-style: normal;
  }

  .social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .social a:hover {
    background: rgb(255 255 255 / 0.1);
  }

  .site-footer__bottom {
    margin-top: 3.5rem;
    padding-block: 1.5rem 6rem; /* room for the floating WhatsApp button */
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: var(--color-on-dark-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 48em) {
    .site-footer__bottom {
      padding-bottom: 1.5rem;
    }
  }
</style>
