---
import { siteConfig } from '../config/site.config';
import { formatAddress, telLink, whatsappLink } from '../lib/utils';
import Icon from './Icon.astro';
import OpeningHours from './OpeningHours.astro';

const platformLabel: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  x: 'X (Twitter)',
  linkedin: 'LinkedIn',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  google: 'Google Business Profile',
};
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__name">{siteConfig.businessName}</p>
      <p>{siteConfig.tagline}</p>
      {
        siteConfig.social.length > 0 && (
          <ul class="social" aria-label="Social media">
            {siteConfig.social.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  <Icon name={s.platform} size={20} />
                  <span class="visually-hidden">{platformLabel[s.platform]} (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div>
      <h2 class="site-footer__heading">Contact</h2>
      <address>
        <p>{formatAddress().map((line, i) => (i === 0 ? line : <><br />{line}</>))}</p>
        <p><a href={telLink()}>{siteConfig.contact.phone}</a></p>
        <p><a href={whatsappLink()} target="_blank" rel="noopener noreferrer">WhatsApp</a></p>
        <p><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></p>
      </address>
    </div>

    <div>
      <h2 class="site-footer__heading">Opening hours</h2>
      <OpeningHours compact />
    </div>

    <nav aria-label="Footer">
      <h2 class="site-footer__heading">Explore</h2>
      <ul class="site-footer__links">
        {siteConfig.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <p>&copy; {year} {siteConfig.businessName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: 3rem;
    background: var(--color-secondary);
    color: var(--color-secondary-contrast);
  }

  .site-footer a {
    color: inherit;
  }

  .site-footer__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 40em) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64em) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1.2fr 0.8fr;
    }
  }

  .site-footer__name {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .site-footer__heading {
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  address {
    font-style: normal;
  }

  address p + p {
    margin-top: 0.35rem;
  }

  .social,
  .site-footer__links {
    list-style: none;
    padding: 0;
  }

  .social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    border-radius: 50%;
  }

  .social a:hover {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .site-footer__links li + li {
    margin-top: 0.35rem;
  }

  .site-footer__bottom {
    margin-top: 2.5rem;
    padding-block: 1.25rem 5.5rem; /* room for the floating WhatsApp button */
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    font-size: 0.9rem;
    opacity: 0.85;
  }

  @media (min-width: 48em) {
    .site-footer__bottom {
      padding-bottom: 1.25rem;
    }
  }
</style>
