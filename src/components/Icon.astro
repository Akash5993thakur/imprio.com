---
/**
 * Tiny inline SVG icon set (no icon library dependency). Paths live in src/lib/icons.ts.
 * Decorative by default (aria-hidden); pass `label` to make it meaningful.
 */
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  <path d={icons[name]}></path>
</svg>
