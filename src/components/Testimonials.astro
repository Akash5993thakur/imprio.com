---
import { siteConfig } from '../config/site.config';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
---

{
  siteConfig.testimonials.length > 0 && (
    <section class="section section--surface" aria-labelledby="testimonials-heading">
      <div class="container">
        <SectionHead copy={siteConfig.home.testimonials} center id="testimonials-heading" />
        <ul class="list-reset grid grid--3">
          {siteConfig.testimonials.map((t, i) => (
            <li class="card testimonial reveal" style={`--reveal-i:${i}`}>
              <figure>
                {t.rating && (
                  <div class="stars" role="img" aria-label={`Rated ${t.rating} out of 5`}>
                    {Array.from({ length: 5 }, (_, n) => (
                      <Icon name="star" size={18} class={n < (t.rating ?? 0) ? 'on' : 'off'} />
                    ))}
                  </div>
                )}
                <blockquote>
                  <p>“{t.quote}”</p>
                </blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  {t.role && <span>{t.role}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .testimonial figure {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1.75rem;
  }

  .stars {
    display: flex;
    gap: 0.15rem;
  }

  .stars :global(.on) {
    color: var(--color-primary);
  }

  .stars :global(.off) {
    color: var(--color-border);
  }

  blockquote {
    flex: 1;
    font-size: 1.05rem;
  }

  figcaption {
    display: flex;
    flex-direction: column;
  }

  figcaption span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
