---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { siteConfig } from '../config/site.config';

const { about } = siteConfig;
const seo = siteConfig.seo.pages.about;
---

<BaseLayout title={seo.title} description={seo.description}>
  <PageHeader copy={about.page} />

  <section class="section" aria-labelledby="story-heading">
    <div class="container story">
      <div>
        <SectionHead copy={about.story} id="story-heading" />
        <div class="story__text reveal">
          {about.story.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>

      {
        about.image ? (
          <img
            class="story__img reveal"
            src={about.image.src}
            alt={about.image.alt}
            width={about.image.width ?? 1200}
            height={about.image.height ?? 900}
            loading="lazy"
            decoding="async"
          />
        ) : (
          about.highlights.length > 0 && (
            <ul class="list-reset highlights">
              {about.highlights.map((h, i) => (
                <li class="reveal" style={`--reveal-i:${i}`}>
                  <strong>{h.value}</strong>
                  <span>{h.label}</span>
                </li>
              ))}
            </ul>
          )
        )
      }
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="approach-heading">
    <div class="container">
      <SectionHead copy={about.approach} id="approach-heading" />
      <FeatureGrid items={about.approach.items} />
    </div>
  </section>

  <Testimonials />
  <CtaBanner />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 60em) {
    .story {
      grid-template-columns: 1.4fr 1fr;
      gap: 5rem;
    }
  }

  .story__text {
    display: grid;
    gap: 1.25rem;
    margin-top: -1rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }

  .story__text p:first-child {
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .story__img {
    width: 100%;
    border-radius: var(--radius);
  }

  .highlights {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 60em) {
    .highlights {
      margin-top: 4.5rem;
    }
  }

  .highlights li {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .highlights li:first-child {
    background: var(--color-secondary);
    border-color: var(--color-secondary);
    color: var(--color-secondary-contrast);
  }

  .highlights strong {
    flex: none;
    min-width: 6.75rem;
    font-size: 2.5rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-primary-text);
  }

  .highlights li:first-child strong {
    color: var(--color-accent);
  }

  .highlights span {
    color: var(--color-muted);
  }

  .highlights li:first-child span {
    color: var(--color-on-dark-muted);
  }
</style>
