---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site.config';
import { linkAttrs } from '../lib/utils';
import { faqSchema } from '../lib/schema';

const { hero, services, why, showFaq } = siteConfig.home;
const primary = linkAttrs(hero.primaryCta);
const secondary = hero.secondaryCta ? linkAttrs(hero.secondaryCta) : undefined;
const jsonLd = showFaq && siteConfig.faq.items.length ? [faqSchema()] : [];
---

<BaseLayout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero glow-bg on-dark" aria-labelledby="hero-heading">
    <div class="container hero__inner">
      <div class="hero__text">
        {hero.eyebrow && <p class="eyebrow hero__in">{hero.eyebrow}</p>}
        <h1 id="hero-heading" class="hero__in" style="--d:1">{hero.heading}</h1>
        <p class="hero__sub hero__in" style="--d:2">{hero.subheading}</p>
        <div class="btn-row hero__in" style="--d:3">
          <a class="btn btn--primary btn--lg" href={primary.href} target={primary.target} rel={primary.rel}>
            {primary.isWhatsapp && <Icon name="whatsapp" size={20} />}
            {hero.primaryCta.label}
          </a>
          {
            hero.secondaryCta && secondary && (
              <a class="btn btn--ghost-light btn--lg" href={secondary.href} target={secondary.target} rel={secondary.rel}>
                {hero.secondaryCta.label}
                <Icon name="arrow" size={18} />
              </a>
            )
          }
        </div>
        {
          hero.trustPoints && hero.trustPoints.length > 0 && (
            <ul class="list-reset hero__trust hero__in" style="--d:4">
              {hero.trustPoints.map((t) => (
                <li>
                  <Icon name="check" size={18} />
                  {t}
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        hero.image && (
          <img
            class="hero__img hero__in"
            style="--d:2"
            src={hero.image.src}
            alt={hero.image.alt}
            width={hero.image.width ?? 1200}
            height={hero.image.height ?? 900}
            fetchpriority="high"
            decoding="async"
          />
        )
      }
    </div>
  </section>

  <!-- What we build -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="services-head">
        <SectionHead copy={services} id="services-heading" />
        <a class="text-link services-head__link" href="/services/">
          {services.linkLabel}
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="grid grid--4">
        {siteConfig.services.map((service, i) => <ServiceCard service={service} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section section--dark glow-bg" aria-labelledby="why-heading">
    <div class="container">
      <SectionHead copy={why} id="why-heading" />
      <FeatureGrid items={why.items} dark />
    </div>
  </section>

  <Process />
  <Testimonials />
  {showFaq && <Faq />}
  <CtaBanner />
</BaseLayout>

<style>
  .hero {
    padding-block: 4rem 4.5rem;
  }

  @media (min-width: 60em) {
    .hero {
      padding-block: 7rem 7.5rem;
    }
  }

  .hero__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 60em) {
    .hero__inner {
      grid-template-columns: 1.05fr 1fr;
      gap: 4rem;
    }
  }

  .hero h1 {
    font-size: clamp(2.75rem, 9vw, 4.75rem);
    line-height: 1.02;
  }

  .hero__sub {
    max-width: 34rem;
    margin-block: 1.5rem 2.25rem;
    color: var(--color-on-dark-muted);
    font-size: clamp(1.0625rem, 2.2vw, 1.25rem);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2.25rem;
    color: var(--color-on-dark-muted);
    font-size: 0.95rem;
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero__trust :global(svg) {
    color: var(--color-accent);
  }

  .hero__img {
    width: 100%;
    filter: drop-shadow(0 30px 60px rgb(0 0 0 / 0.35));
  }

  /* Gentle entrance for hero content */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: hero-in 0.8s var(--ease) both;
      animation-delay: calc(var(--d, 0) * 90ms);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .services-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 2rem;
  }

  .services-head__link {
    margin-bottom: 2.5rem;
  }

  @media (min-width: 48em) {
    .services-head__link {
      margin-bottom: 3.5rem;
    }
  }
</style>
