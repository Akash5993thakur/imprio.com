---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Process from '../components/Process.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { siteConfig } from '../config/site.config';

const seo = siteConfig.seo.pages.services;
---

<BaseLayout title={seo.title} description={seo.description}>
  <PageHeader copy={siteConfig.servicesPage} />

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        {siteConfig.services.map((service, i) => <ServiceCard service={service} variant="detailed" index={i % 2} />)}
      </div>
    </div>
  </section>

  <div class="section--surface">
    <Process />
  </div>
  <CtaBanner />
</BaseLayout>

<style>
  .section--surface :global(.step) {
    background: var(--color-bg);
  }
</style>
